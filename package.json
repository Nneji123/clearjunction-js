{
  "name": "clearjunction-js",
  "version": "0.1.0",
  "description": "Standalone TypeScript SDK for the Clear Junction REST API. Not an official Clear Junction product.",
  "author": "Nneji Ifeanyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nneji123/clearjunction-js.git"
  },
  "homepage": "https://github.com/Nneji123/clearjunction-js#readme",
  "bugs": {
    "url": "https://github.com/Nneji123/clearjunction-js/issues"
  },
  "keywords": [
    "clearjunction",
    "clear-junction",
    "payments",
    "sepa",
    "sepa-instant",
    "faster-payments",
    "chaps",
    "swift",
    "iban",
    "virtual-iban",
    "payouts",
    "fintech",
    "webhooks",
    "typescript",
    "sdk"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
